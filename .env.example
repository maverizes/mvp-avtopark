# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring.

NODE_ENV=production
PORT=3000

# Operator paneli (/admin) paroli — kamida 12 belgi. Majburiy.
ADMIN_PASSWORD=

# Sayt manzili (HTTPS). Cookie va so'rov manbasini tekshirish uchun.
PUBLIC_ORIGIN=https://joybor.uz
# Caddy uchun domen (docker-compose)
DOMAIN=joybor.uz

# Server Caddy/Nginx ortida bo'lsa — true (haqiqiy IP va https ni o'qish uchun)
TRUST_PROXY=true

# Yangi bron haqida operatorga Telegram xabar (ixtiyoriy).
# Bot: @BotFather -> /newbot. Chat ID: botga yozing va https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Namuna turargohlarni bazaga qo'shish (faqat sinov uchun)
SEED_DEMO=false

# Ma'lumotlar bazasi: lokal fayl (VPS/Docker)
DB_PATH=data/joybor.db

# Yoki Turso (Vercel'da majburiy): berilsa, lokal fayl o'rniga shu ishlatiladi
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
